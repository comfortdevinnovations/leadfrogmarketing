# Copy to .env.local and fill in. Never commit real values.

# SMTP transport. For Gmail use an App Password (not the account password),
# generated at https://myaccount.google.com/apppasswords with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password

# Gmail only lets you send as the authenticated account (or a verified alias),
# so MAIL_FROM_ADDRESS must stay equal to SMTP_USER. Display name is free-form.
MAIL_FROM_NAME=Lead Frog Marketing
MAIL_FROM_ADDRESS=you@example.com

# Where contact-form submissions are delivered. Comma-separated for multiple;
# all visible to each other. The first address is used as Reply-To on the
# confirmation sent to the lead.
# e.g. CONTACT_TO_EMAIL=hello@example.com,sales@example.com
CONTACT_TO_EMAIL=hello@example.com

# Silent copies of inbound enquiries — not visible to the other recipients.
# Comma-separated. Leave empty to disable. Applies to the internal
# notification only, never to the confirmation sent to the lead.
# e.g. CONTACT_BCC_EMAIL=archive@example.com,crm-dropbox@example.com
CONTACT_BCC_EMAIL=
